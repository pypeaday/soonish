NOTIFIQ_IMAGE=notifiq-app:dev
API_PORT=8000
DATABASE_URL=sqlite+aiosqlite:////data/notifiq.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
POSTGRES_USER=notifiq
POSTGRES_PASSWORD=notifiq
POSTGRES_DB=notifiq
TEMPORAL_URL=ghost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=notifiq-task-queue
ENCRYPTION_KEY=
SECRET_KEY=
DEBUG=true
DEV_MODE=true
ADMIN_EMAILS=admin@example.com
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUST_PROXY_HEADERS=false
BILLING_ENABLED=false
LOG_LEVEL=INFO
FRONTEND_URLS={"soonish":"http://localhost:8000","mission-control":"http://localhost:8000/mission-control","notifiq-event-planner":"http://localhost:8000/event-planner","notifiq-volunteer-coordinator":"http://localhost:8000/volunteer-coordinator","notifiq-theater-volunteer":"http://localhost:8000/stage-manager","notifiq-eisenhower":"http://localhost:8000/tasks","notifiq-adhd-reminders":"http://localhost:8000/adhd-reminders","notifiq-it-console":"http://localhost:8000/duty-pager"}
SPA_ROOT=/srv/notifiq/frontends/frontend-website/dist
SPA_MOUNTS={"/mission-control":"/srv/notifiq/frontends/frontend-mission-control/dist","/volunteer-coordinator":"/srv/notifiq/frontends/frontend-volunteer-coordinator/dist","/event-planner":"/srv/notifiq/frontends/frontend-event-planner/dist","/duty-pager":"/srv/notifiq/frontends/frontend-it-team-alerts/dist","/developer-user":"/srv/notifiq/frontends/frontend-developer-user/dist","/tasks":"/srv/notifiq/frontends/frontend-eisenhower-tasks/dist","/stage-manager":"/srv/notifiq/frontends/frontend-theater-volunteer/dist","/adhd-reminders":"/srv/notifiq/frontends/frontend-adhd-reminders/dist"}
